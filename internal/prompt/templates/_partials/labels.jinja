{% macro genre(code) -%}
{% if code == "narrative" %}记叙文{% elif code == "argumentative" %}议论文{% elif code == "prose" %}散文{% elif code == "poetry" %}诗歌{% elif code == "essay" %}杂文{% elif code == "expository" %}说明文{% elif code == "practical" %}应用文{% else %}未指定文体{% endif %}
