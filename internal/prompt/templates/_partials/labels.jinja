{% if code == "opening" %}开头段{% elif code == "closing" %}结尾段{% elif code == "callback" %}Call Back 段{% elif code == "lyric" %}抒情段{% elif code == "transition" %}转折段{% else %}普通段{% endif %}
{%- endmacro %}

